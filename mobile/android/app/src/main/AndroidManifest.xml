<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Jaro registers no non-exported dynamic receivers through ContextCompat. -->
    <permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- The keyboard reads Android's personal dictionary (UserDictionary.Words), which only the enabled
         input method may read; declared so package visibility never hides the provider. -->
    <queries>
        <provider android:authorities="user_dictionary" />
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:theme="@style/JaroApp" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".keyboard.JaroKeyboard" android:label="@string/app_name"
            android:theme="@style/JaroIme" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
        <service android:name=".QuickDictationTile" android:exported="true" android:enabled="false"
            android:label="@string/quick_tile" android:icon="@drawable/jaro_mark"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity android:name=".QuickDictationActivity" android:exported="false" android:theme="@style/JaroSheet"
            android:taskAffinity="" android:launchMode="singleTask" android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale" />
    </application>
</manifest>
