{
  "id": "local.jardaudio.desktop",
  "name": "jard-soundfolio-local",
  "display_name": "Jaro",
  "description": "Local dictation, meeting recordings, and transcripts on your Mac.",
  "version": "0.0.11",
  "platforms": [
    "macos"
  ],
  "icons": [
    "assets/icon.png"
  ],
  "web_engine": "system",
  "capabilities": [
    "webview",
    "js_bridge",
    "menus"
  ],
  "permissions": [
    "view",
    "microphone",
    "system_audio"
  ],
  "security": {
    "navigation": {
      "allowed_origins": [
        "zero://inline",
        "http://127.0.0.1:8765"
      ],
      "external_links": {
        "action": "deny"
      }
    }
  },
  "windows": [
    {
      "label": "main",
      "title": "Jaro",
      "width": 1050,
      "height": 760,
      "titlebar": "hidden_inset_tall",
      "restore_state": true
    }
  ],
  "updates": {
    "feed_url": "https://github.com/AdamGera/Jaro/releases/latest/download/native-update.json",
    "public_key": "dxMjVxu9nD8oMW/Cx+DNTJ2sYv8JS8z95lJkz63hBMM=",
    "check_on_start": true
  }
}
